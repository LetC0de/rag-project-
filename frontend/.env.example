# Copy to .env and adjust. Vite exposes VITE_* variables to the client at build time.
# Production (deployed frontend -> deployed backend):
VITE_API_BASE_URL=https://your-backend_url

# Local dev with FastAPI on :8000 (Vite dev proxy /api -> :8000 still works):
# VITE_API_BASE_URL=http://localhost:8000
